# ---------- เซิร์ฟเวอร์ ----------
PORT=4000
NODE_ENV=development
TZ=Asia/Bangkok
# origin ของ frontend ตอน dev (Vite) ใช้สำหรับ CORS
CLIENT_ORIGIN=http://localhost:5173

# ---------- ฐานข้อมูลของระบบ (claim_recon) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claim_recon
DB_USER=recon
DB_PASSWORD=recon_pass

# ---------- ฐานข้อมูล HOSxP (อ่านอย่างเดียว / แนะนำให้ชี้ไปที่ replica) ----------
HOSXP_HOST=192.168.1.10
HOSXP_PORT=5432
HOSXP_DB=hos
HOSXP_USER=claim_reader
HOSXP_PASSWORD=change_me

# ---------- กองทุน ----------
# กลุ่มสิทธิ (hipdata_code ในตาราง pttype ของ HOSxP) ที่ไม่นับเข้ากองทุนใด ๆ เสมอ เช่น ชำระเงินเอง
# หลายกลุ่มคั่นด้วยจุลภาค เช่น XXX,A1
EXCLUDED_HIPDATA=XXX

# ---------- การยืนยันตัวตน ----------
# สร้างค่าสุ่มยาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_HOURS=8

# admin เริ่มต้น (ใช้ตอนรัน npm run seed ครั้งแรก แล้วเปลี่ยนรหัสผ่านทันที)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234
